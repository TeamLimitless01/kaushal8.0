generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
  USER
}

enum WasteCategory {
  RECYCLABLE_DRY
  ORGANIC_WET
  HAZARDOUS
  E_WASTE
  LANDFILL_RESIDUAL
  SPECIAL_HANDLING
}

enum BinType {
  BLUE_RECYCLABLE
  GREEN_ORGANIC
  RED_HAZARDOUS
  YELLOW_EWASTE
  BLACK_LANDFILL
}

enum ResourceType {
  ELECTRICITY
  WATER
  WASTE
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model User {
  id           String      @id @default(cuid())
  name         String?
  email        String      @unique
  passwordHash String
  role         Role        @default(ADMIN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  imports      Import[]
  scans        WasteScan[]

  @@map("users")
}

model Campus {
  id             String          @id @default(cuid())
  name           String          @default("SVVV Campus")
  location       String          @default("Indore")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  buildings      Building[]
  imports        Import[]
  resourceUsages ResourceUsage[]

  @@map("campuses")
}

model Building {
  id             String          @id @default(cuid())
  campusId       String
  campus         Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rooms          Room[]
  resourceUsages ResourceUsage[]

  @@unique([campusId, name])
  @@map("buildings")
}

model Room {
  id             String          @id @default(cuid())
  buildingId     String
  building       Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resourceUsages ResourceUsage[]

  @@unique([buildingId, name])
  @@map("rooms")
}

model Import {
  id              String          @id @default(cuid())
  campusId        String
  campus          Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  uploadedById    String?
  uploadedBy      User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName        String
  cloudinaryUrl   String?
  publicId        String?
  rowCount        Int             @default(0)
  validRowCount   Int             @default(0)
  invalidRowCount Int             @default(0)
  dateFrom        DateTime?       @db.Date
  dateTo          DateTime?       @db.Date
  status          ImportStatus    @default(PROCESSING)
  summary         Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resourceUsages  ResourceUsage[]

  @@map("imports")
}

model ResourceUsage {
  id             String       @id @default(cuid())
  campusId       String
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resourceType   ResourceType
  usage          Float
  unit           String
  operatingHours Float?
  recordedDate   DateTime     @db.Date
  importId       String?
  import         Import?      @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([campusId, buildingId, roomId, resourceType, recordedDate])
  @@index([recordedDate])
  @@index([resourceType])
  @@index([buildingId])
  @@map("resource_usages")
}

model WasteRule {
  id                    String        @id @default(cuid())
  itemName              String        @unique
  aliases               String[]      @default([])
  category              WasteCategory
  primaryBin            BinType
  material              String
  prepInstructions      String[]      @default([])
  disposalLocation      String        @default("Campus Quad Waste Stations")
  isHazardous           Boolean       @default(false)
  hazardousWarning      String?
  requiresClarification Boolean       @default(false)
  clarificationQuestion String?
  clarificationOptions  Json?
  searchKeywords        String[]      @default([])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("waste_rules")
}

model WasteStation {
  id             String      @id
  name           String
  location       String
  availableBins  String[]    @default(["BLUE_RECYCLABLE", "GREEN_ORGANIC", "BLACK_LANDFILL"])
  hasEwasteDrop  Boolean     @default(false)
  hasBatteryDrop Boolean     @default(false)
  qrCodeData     String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  scans          WasteScan[]

  @@map("waste_stations")
}

model WasteScan {
  id                  String        @id @default(cuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stationId           String?
  station             WasteStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  imageUrl            String?
  detectedItem        String
  detectedCategory    String
  confidenceScore     Float
  wasClarified        Boolean       @default(false)
  userClarification   String?
  finalBinRecommended String
  feedbackStatus      String?
  feedbackComment     String?
  createdAt           DateTime      @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("waste_scans")
}
